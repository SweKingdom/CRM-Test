# Zephyr local stack configuration.
# Do not edit this file with real secrets. Run `node scripts/setup-env.mjs`
# to create a gitignored .env with a random password for every `change-me`.
# Dev-only defaults: everything here runs on localhost with synthetic data.

# PostgreSQL
POSTGRES_DB=zephyr
POSTGRES_USER=zephyr
POSTGRES_PASSWORD=change-me

# API database connection (the password here is kept in sync with POSTGRES_PASSWORD by setup-env)
ZEPHYR_DB=Host=db;Port=5432;Database=zephyr;Username=zephyr;Password=change-me

# Mail (Mailpit catches all mail locally)
SMTP_HOST=mailpit
SMTP_PORT=1025

# OIDC sign-in (Keycloak realm zephyr, client zephyr-web). The client secret is also used by the realm templates.
OIDC_ISSUER=http://localhost:8180/realms/zephyr
OIDC_CLIENT_ID=zephyr-web
OIDC_CLIENT_SECRET=change-me

# Sign-in providers read by the API (US-140). One numbered block per provider; providers are added by configuration only.
# NAME (lowercase letters, digits, dashes) becomes the callback path /signin-oidc-{name}.
# EMAILTRUSTED=true lets a verified email from this provider link a pre-provisioned user on first sign-in.
# The AUTHORITY must be reachable from the API process and from the browser: run the API on the host
# (dotnet run) when the authority is http://localhost:8180.
ZEPHYR_AUTH__PROVIDERS__0__NAME=zephyr
ZEPHYR_AUTH__PROVIDERS__0__AUTHORITY=http://localhost:8180/realms/zephyr
ZEPHYR_AUTH__PROVIDERS__0__CLIENTID=zephyr-web
ZEPHYR_AUTH__PROVIDERS__0__CLIENTSECRET=change-me
ZEPHYR_AUTH__PROVIDERS__0__EMAILTRUSTED=true
# Second realm (issuer switch test): remove the leading # of the five lines below. Same build, only configuration changes.
# ZEPHYR_AUTH__PROVIDERS__1__NAME=zephyr-b
# ZEPHYR_AUTH__PROVIDERS__1__AUTHORITY=http://localhost:8180/realms/zephyr-b
# ZEPHYR_AUTH__PROVIDERS__1__CLIENTID=zephyr-web
# ZEPHYR_AUTH__PROVIDERS__1__CLIENTSECRET=change-me
# ZEPHYR_AUTH__PROVIDERS__1__EMAILTRUSTED=true

# First administrator in Zephyr: issuer + subject (user id of admin@example.com in realm zephyr).
# Used only while no active administrator exists; ignored afterwards. Its use is logged and audited.
ZEPHYR_BOOTSTRAP_ADMIN_ISSUER=http://localhost:8180/realms/zephyr
ZEPHYR_BOOTSTRAP_ADMIN_SUBJECT=7c1f0a52-3b8e-4d6a-9f21-5e4b8a0c1d01

# Keycloak admin console (http://localhost:8180)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

# Keycloak test users in realm zephyr, one per role (passwords generated by setup-env)
KC_USER_ADMIN_PASSWORD=change-me
KC_USER_SALESPERSON_PASSWORD=change-me
KC_USER_BDR_PASSWORD=change-me
KC_USER_PROJECT_MANAGER_PASSWORD=change-me
KC_USER_CONSULTANT_PASSWORD=change-me
KC_USER_FINANCE_PASSWORD=change-me
KC_USER_MANAGEMENT_PASSWORD=change-me

# Password of user-b@example.com in realm zephyr-b (issuer switch test)
KC_USER_B_PASSWORD=change-me
