# Zephyr local stack configuration.
# Do not edit this file with real secrets. Run `node scripts/setup-env.mjs`
# to create a gitignored .env with a random password for every `change-me`.
# Dev-only defaults: everything here runs on localhost with synthetic data.

# PostgreSQL
POSTGRES_DB=zephyr
POSTGRES_USER=zephyr
POSTGRES_PASSWORD=change-me

# API database connection (the password here is kept in sync with POSTGRES_PASSWORD by setup-env)
ZEPHYR_DB=Host=db;Port=5432;Database=zephyr;Username=zephyr;Password=change-me

# Mail (Mailpit catches all mail locally)
SMTP_HOST=mailpit
SMTP_PORT=1025

# OIDC sign-in (Keycloak realm zephyr, client zephyr-web)
OIDC_ISSUER=http://localhost:8180/realms/zephyr
OIDC_CLIENT_ID=zephyr-web
OIDC_CLIENT_SECRET=change-me

# First administrator in Zephyr: issuer + subject (user id of admin@example.com in realm zephyr)
ZEPHYR_BOOTSTRAP_ADMIN_ISSUER=http://localhost:8180/realms/zephyr
ZEPHYR_BOOTSTRAP_ADMIN_SUBJECT=7c1f0a52-3b8e-4d6a-9f21-5e4b8a0c1d01

# Keycloak admin console (http://localhost:8180)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

# Keycloak test users in realm zephyr, one per role (passwords generated by setup-env)
KC_USER_ADMIN_PASSWORD=change-me
KC_USER_SALESPERSON_PASSWORD=change-me
KC_USER_BDR_PASSWORD=change-me
KC_USER_PROJECT_MANAGER_PASSWORD=change-me
KC_USER_CONSULTANT_PASSWORD=change-me
KC_USER_FINANCE_PASSWORD=change-me
KC_USER_MANAGEMENT_PASSWORD=change-me

# Password of user-b@example.com in realm zephyr-b (issuer switch test)
KC_USER_B_PASSWORD=change-me
