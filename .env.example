# Zephyr local stack configuration.
# Do not edit this file with real secrets. Run `node scripts/setup-env.mjs`
# to create a gitignored .env with random passwords for every `change-me`.
# Dev-only defaults: everything here runs on localhost with synthetic data.

# PostgreSQL
POSTGRES_DB=zephyr
POSTGRES_USER=zephyr
POSTGRES_PASSWORD=change-me

# API (the password here is kept in sync with POSTGRES_PASSWORD by setup-env)
ConnectionStrings__Default=Host=db;Port=5432;Database=zephyr;Username=zephyr;Password=change-me

# Mail (Mailpit catches all mail locally)
SMTP_HOST=mailpit
SMTP_PORT=1025

# OIDC sign-in (Keycloak realm, see US-128)
OIDC_ISSUER=http://localhost:8180/realms/zephyr
OIDC_CLIENT_ID=zephyr
OIDC_CLIENT_SECRET=change-me

# First administrator, matched on first sign-in (issuer + subject)
ZEPHYR_BOOTSTRAP_ADMIN_ISSUER=http://localhost:8180/realms/zephyr
ZEPHYR_BOOTSTRAP_ADMIN_SUBJECT=change-me

# Keycloak admin console
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Keycloak test users, one per role (passwords generated by setup-env)
KC_USER_ADMIN_PASSWORD=change-me
KC_USER_SALESPERSON_PASSWORD=change-me
KC_USER_BDR_PASSWORD=change-me
KC_USER_PROJECT_MANAGER_PASSWORD=change-me
KC_USER_CONSULTANT_PASSWORD=change-me
KC_USER_FINANCE_PASSWORD=change-me
KC_USER_MANAGEMENT_PASSWORD=change-me
