# Copy to .env and fill in every empty value. .env is gitignored; never commit real secrets.
# (US-127 owns the full file; the Keycloak entries below belong to US-128.)

# Keycloak admin console (http://localhost:8180)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# First admin in Zephyr: issuer + subject of admin@example.com in realm zephyr
ZEPHYR_BOOTSTRAP_ADMIN_ISSUER=http://localhost:8180/realms/zephyr
ZEPHYR_BOOTSTRAP_ADMIN_SUBJECT=7c1f0a52-3b8e-4d6a-9f21-5e4b8a0c1d01

# Client secret of the zephyr-web client in both realms
OIDC_CLIENT_SECRET=

# Passwords of the seven test users in realm zephyr
KC_USER_ADMIN_PASSWORD=
KC_USER_SALESPERSON_PASSWORD=
KC_USER_BDR_PASSWORD=
KC_USER_PROJECT_MANAGER_PASSWORD=
KC_USER_CONSULTANT_PASSWORD=
KC_USER_FINANCE_PASSWORD=
KC_USER_MANAGEMENT_PASSWORD=

# Password of user-b@example.com in realm zephyr-b (issuer switch test)
KC_USER_B_PASSWORD=
