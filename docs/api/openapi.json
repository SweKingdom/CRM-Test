{
  "openapi": "3.1.0",
  "info": {
    "contact": {
      "name": "Zephyr team"
    },
    "description": "Headless REST API of Zephyr (CRM and project operations). This file is generated by tools/openapi-from-metadata/generate.mjs from field metadata: generated, do not edit. To change it, change the metadata and run the generator. Conventions: base /api/v1, camelCase JSON, keyset paging with limit and cursor, filter[field][op] and sort, strong ETag with If-Match, errors as application/problem+json.",
    "title": "Zephyr API",
    "version": "1.0.0"
  },
  "components": {
    "headers": {
      "ETag": {
        "description": "Strong ETag of the record. Send it back in If-Match to change the record.",
        "schema": {
          "type": "string"
        }
      },
      "Location": {
        "description": "URL of the created record.",
        "schema": {
          "type": "string"
        }
      }
    },
    "parameters": {
      "Csrf": {
        "description": "Send 1 on writes that use the session cookie (the web app does). Without it the write is refused with 403.",
        "in": "header",
        "name": "X-Zephyr-Csrf",
        "schema": {
          "enum": [
            "1"
          ],
          "type": "string"
        }
      },
      "Cursor": {
        "description": "The nextCursor of the previous page. Leave it out for the first page.",
        "in": "query",
        "name": "cursor",
        "schema": {
          "type": "string"
        }
      },
      "Filter": {
        "description": "Filters as filter[field][op]=value, where op is eq, ne, gt, gte, lt, lte, contains (text) or in (comma-separated values). Every filter must match.",
        "explode": true,
        "in": "query",
        "name": "filter",
        "schema": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "type": "object"
        },
        "style": "deepObject"
      },
      "IfMatch": {
        "description": "The ETag you last read. Needed to change an existing record with PATCH: 428 when missing, 412 when the record changed since.",
        "in": "header",
        "name": "If-Match",
        "schema": {
          "type": "string"
        }
      },
      "Limit": {
        "description": "Page size from 1 to 200, default 50. A larger value is a 400, it is not capped.",
        "in": "query",
        "name": "limit",
        "schema": {
          "default": 50,
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        }
      },
      "Sort": {
        "description": "Comma-separated field names with a leading minus for descending, for example -updatedAt. id is always the last key.",
        "in": "query",
        "name": "sort",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        },
        "description": "The request is malformed: an unreadable body, an unknown parameter or a value out of range. errors names what is wrong."
      },
      "Conflict": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        },
        "description": "The record behind the external id was deleted and is not restored by an upsert."
      },
      "Forbidden": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        },
        "description": "The signed-in user may not do this, or a write with the session cookie lacks the X-Zephyr-Csrf header."
      },
      "NotFound": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        },
        "description": "The record does not exist or was deleted."
      },
      "Unauthorized": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        },
        "description": "Nobody is signed in. Sign in and try again."
      },
      "ValidationFailed": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        },
        "description": "One or more fields are invalid. errors has one entry per field."
      }
    },
    "schemas": {
      "Account": {
        "description": "A customer or prospect company.",
        "properties": {
          "countryCode": {
            "description": "Country as two capital letters, for example SE. Leave it out or send null to clear it.",
            "maxLength": 2,
            "pattern": "^[A-Z]{2}$",
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "description": "When the record was created.",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "Identifier assigned by Zephyr.",
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "description": "Company name. Leading and trailing spaces are removed.",
            "type": "string"
          },
          "updatedAt": {
            "description": "When the record was last changed.",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "countryCode",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "AccountInput": {
        "description": "The fields a client may send for Account.",
        "properties": {
          "countryCode": {
            "description": "Country as two capital letters, for example SE. Leave it out or send null to clear it.",
            "maxLength": 2,
            "pattern": "^[A-Z]{2}$",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "Company name. Leading and trailing spaces are removed.",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "CurrentUser": {
        "description": "The signed-in user.",
        "properties": {
          "email": {
            "description": "Email address.",
            "type": "string"
          },
          "homeCountry": {
            "description": "Home country as two capital letters, or null.",
            "maxLength": 2,
            "pattern": "^[A-Z]{2}$",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "Identifier of the user.",
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "description": "Display name.",
            "type": "string"
          },
          "roles": {
            "description": "Role keys, for example Admin or Salesperson.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "roles",
          "homeCountry"
        ],
        "type": "object"
      },
      "ExchangeRate": {
        "description": "SEK per unit of a currency in one month. SEK itself has no rate: it is always 1.",
        "properties": {
          "currency": {
            "description": "Currency code as three capital letters, for example USD.",
            "maxLength": 3,
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          },
          "id": {
            "description": "Identifier assigned by Zephyr.",
            "format": "uuid",
            "type": "string"
          },
          "month": {
            "description": "First day of the month the rate applies to.",
            "format": "date",
            "type": "string"
          },
          "rateToSek": {
            "description": "SEK per unit of the currency, as text with at most 6 decimals, for example 10.50. A JSON number is accepted when writing. Responses always show 6 decimals.",
            "pattern": "^[0-9]+(\\.[0-9]{1,6})?$",
            "type": "string"
          },
          "updatedAt": {
            "description": "When the rate was last changed.",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "currency",
          "month",
          "rateToSek",
          "updatedAt"
        ],
        "type": "object"
      },
      "ExchangeRateInput": {
        "description": "The fields a client may send for ExchangeRate.",
        "properties": {
          "rateToSek": {
            "description": "SEK per unit of the currency, as text with at most 6 decimals, for example 10.50. A JSON number is accepted when writing. Responses always show 6 decimals.",
            "pattern": "^[0-9]+(\\.[0-9]{1,6})?$",
            "type": "string"
          }
        },
        "required": [
          "rateToSek"
        ],
        "type": "object"
      },
      "FieldError": {
        "description": "One failing field.",
        "properties": {
          "code": {
            "description": "Machine-readable error code, for example VALIDATION.",
            "type": "string"
          },
          "field": {
            "description": "The field or parameter that failed, for example name or filter[month][gte].",
            "type": "string"
          },
          "message": {
            "description": "What is wrong and how to fix it.",
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "type": "object"
      },
      "Money": {
        "description": "An amount in its own currency and in SEK, stamped with the exchange rate of the record month. Amounts are strings.",
        "properties": {
          "amount": {
            "description": "Amount with 2 decimals.",
            "pattern": "^-?[0-9]{1,16}(\\.[0-9]{1,2})?$",
            "type": "string"
          },
          "amountSEK": {
            "description": "Amount in SEK with 2 decimals.",
            "pattern": "^-?[0-9]{1,16}(\\.[0-9]{1,2})?$",
            "type": "string"
          },
          "currency": {
            "description": "Currency code as three capital letters.",
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          },
          "rateDate": {
            "description": "First day of the month whose exchange rate was used.",
            "format": "date",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency",
          "amountSEK",
          "rateDate"
        ],
        "type": "object"
      },
      "Page": {
        "description": "One page of a list response (keyset paging).",
        "properties": {
          "items": {
            "description": "The rows of this page.",
            "items": {},
            "type": "array"
          },
          "nextCursor": {
            "description": "Send as cursor to get the next page. Null on the last page.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "description": "RFC 9457 problem, served as application/problem+json.",
        "properties": {
          "code": {
            "description": "Machine-readable error code, for example VALIDATION.",
            "type": "string"
          },
          "detail": {
            "description": "What went wrong and what to do about it.",
            "type": "string"
          },
          "errors": {
            "description": "One entry per failing field.",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "status": {
            "description": "The HTTP status code.",
            "type": "integer"
          },
          "title": {
            "description": "Short summary of the problem.",
            "type": "string"
          },
          "traceId": {
            "description": "Quote this when you report a problem.",
            "type": "string"
          },
          "type": {
            "description": "A URN naming the problem, for example urn:zephyr:problem:validation, or about:blank.",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "traceId"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "cookieAuth": {
        "description": "Session cookie set after sign-in with an identity provider. Writes that use it also need the X-Zephyr-Csrf header.",
        "in": "cookie",
        "name": "zephyr.session",
        "type": "apiKey"
      }
    }
  },
  "paths": {
    "/accounts/by-external-id/{system}/{value}": {
      "put": {
        "description": "Idempotent. Creates the account (201) when the external id is new, otherwise updates the account it maps to (200). Admin and Integration roles only. If-Match is ignored.",
        "operationId": "upsertAccountByExternalId",
        "parameters": [
          {
            "description": "The system that owns the id.",
            "in": "path",
            "name": "system",
            "required": true,
            "schema": {
              "enum": [
                "dynamics",
                "fortnox"
              ],
              "type": "string"
            }
          },
          {
            "description": "The id in that system.",
            "in": "path",
            "name": "value",
            "required": true,
            "schema": {
              "maxLength": 200,
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/Csrf"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            },
            "description": "Updated.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            }
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            },
            "description": "Created. Location points at the new record.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Location": {
                "$ref": "#/components/headers/Location"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          }
        },
        "summary": "Create or update an account by external id",
        "tags": [
          "Accounts"
        ]
      }
    },
    "/accounts/{id}": {
      "delete": {
        "description": "Soft delete: the account no longer appears in reads. Admin only.",
        "operationId": "deleteAccount",
        "parameters": [
          {
            "description": "Identifier of the account.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/Csrf"
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted. The record no longer appears in reads."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "summary": "Delete an account",
        "tags": [
          "Accounts"
        ]
      }
    },
    "/auth/denied": {
      "get": {
        "description": "Anonymous. Where the browser lands after a refused sign-in. Always answers 403.",
        "operationId": "getSignInDenied",
        "parameters": [
          {
            "description": "failed when sign-in did not complete. Otherwise the user is not set up in Zephyr.",
            "in": "query",
            "name": "reason",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        },
        "security": [],
        "summary": "Show why sign-in was refused",
        "tags": [
          "Authentication"
        ]
      },
      "servers": [
        {
          "description": "Site root: this route is not under /api/v1.",
          "url": "/"
        }
      ]
    },
    "/auth/login": {
      "get": {
        "description": "Anonymous. Redirects the browser to the identity provider (OpenID Connect code flow with PKCE).",
        "operationId": "signIn",
        "parameters": [
          {
            "description": "Name of a configured sign-in provider. The first configured provider is used when left out.",
            "in": "query",
            "name": "provider",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "A path on this site to return to after sign-in, for example /accounts.",
            "in": "query",
            "name": "returnUrl",
            "schema": {
              "pattern": "^/",
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the identity provider.",
            "headers": {
              "Location": {
                "$ref": "#/components/headers/Location"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        },
        "security": [],
        "summary": "Start sign-in",
        "tags": [
          "Authentication"
        ]
      },
      "servers": [
        {
          "description": "Site root: this route is not under /api/v1.",
          "url": "/"
        }
      ]
    },
    "/auth/logout": {
      "post": {
        "description": "Ends the session.",
        "operationId": "signOut",
        "parameters": [
          {
            "$ref": "#/components/parameters/Csrf"
          }
        ],
        "responses": {
          "204": {
            "description": "Signed out."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        },
        "summary": "Sign out",
        "tags": [
          "Authentication"
        ]
      },
      "servers": [
        {
          "description": "Site root: this route is not under /api/v1.",
          "url": "/"
        }
      ]
    },
    "/auth/me": {
      "get": {
        "description": "The active user behind the session.",
        "operationId": "getCurrentUser",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            },
            "description": "The signed-in user."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        },
        "summary": "Get the signed-in user",
        "tags": [
          "Authentication"
        ]
      },
      "servers": [
        {
          "description": "Site root: this route is not under /api/v1.",
          "url": "/"
        }
      ]
    },
    "/exchange-rates": {
      "get": {
        "description": "Rates of all currencies and months, most recently changed first by default. Filter and sort fields: currency, month, updatedAt, id.",
        "operationId": "listExchangeRates",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/Filter"
          },
          {
            "$ref": "#/components/parameters/Sort"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Page"
                    },
                    {
                      "properties": {
                        "items": {
                          "items": {
                            "$ref": "#/components/schemas/ExchangeRate"
                          },
                          "type": "array"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "description": "One page of results. nextCursor is null on the last page."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        },
        "summary": "List exchange rates",
        "tags": [
          "Exchange rates"
        ]
      }
    },
    "/exchange-rates/{currency}/{month}": {
      "put": {
        "description": "Admin only. Creates the rate (201) or replaces the existing one (200).",
        "operationId": "putExchangeRate",
        "parameters": [
          {
            "description": "Currency code, for example USD. SEK has no rate.",
            "in": "path",
            "name": "currency",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z]{3}$",
              "type": "string"
            }
          },
          {
            "description": "Month as yyyy-MM, for example 2026-11.",
            "in": "path",
            "name": "month",
            "required": true,
            "schema": {
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/Csrf"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExchangeRateInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExchangeRate"
                }
              }
            },
            "description": "Updated.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            }
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExchangeRate"
                }
              }
            },
            "description": "Created. Location points at the new record.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Location": {
                "$ref": "#/components/headers/Location"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          }
        },
        "summary": "Set the exchange rate of a currency for a month",
        "tags": [
          "Exchange rates"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Anonymous. 200 when the API is up and the database answers, 503 otherwise.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status": {
                      "description": "Health of the API and its database.",
                      "enum": [
                        "Healthy"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The API and the database are reachable."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status": {
                      "description": "Health of the API and its database.",
                      "enum": [
                        "Unhealthy",
                        "Degraded"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The database is not reachable."
          }
        },
        "security": [],
        "summary": "Check health",
        "tags": [
          "System"
        ]
      },
      "servers": [
        {
          "description": "Site root: this route is not under /api/v1.",
          "url": "/"
        }
      ]
    }
  },
